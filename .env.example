# Local MySQL development. Use the project account password in your untracked .env.
MYSQL_DATABASE=naengcook
MYSQL_USER=naengcook
MYSQL_PASSWORD=replace_with_local_password
MYSQL_PORT=3306
DB_HOST=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Docker is deferred. Only needed if using compose.yaml later:
# MYSQL_ROOT_PASSWORD=replace_with_local_root_password
